# Copy to .env.local and fill in your Neon connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Calendar day used for due dates and "hoy/ayer" labels.
APP_TIMEZONE="America/Bogota"

# --- Authentication (Better Auth) -------------------------------------------
# Signs session cookies and encrypts OAuth tokens. Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""
# Public URL of the app, without a trailing slash (https://… in production).
BETTER_AUTH_URL="http://localhost:3000"

# Google: console.cloud.google.com → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web).
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple: developer.apple.com → Certificates, IDs & Profiles. Needs a public HTTPS domain (no localhost).
# Return URL: {BETTER_AUTH_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=""          # Services ID, e.g. com.tuempresa.nexora.web
APPLE_TEAM_ID=""            # 10 characters, top right of the developer portal
APPLE_KEY_ID=""             # ID of the "Sign in with Apple" key
APPLE_PRIVATE_KEY=""        # Contents of the .p8 file, newlines written as \n
APPLE_APP_BUNDLE_ID=""      # Optional: only if you also have a native iOS app

# Optional: who may sign in. Exact addresses and/or whole domains, comma separated. Empty = anyone.
AUTH_ALLOWED_EMAILS=""
